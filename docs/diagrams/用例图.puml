@startuml log-insight-用例图
' ============================================================
'  log-insight · UML 用例图
'  依据: backend/app/api/*.py + frontend/src/rbac/permissions.ts
'        + frontend/src/router/index.ts (v0.2 已实现)
'  说明: 双级权限模型 —— 平台级(admin/普通) × 团队级(创建者/管理员/成员)
'        平台管理员对任意团队具备"创建者"级权限 (is_platform_admin)
' ============================================================
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #F5F9FF
    BorderColor       #2F6FB0
    ArrowColor        #333333
}
skinparam actor {
    BorderColor #2F6FB0
}
title log-insight · 用例图
' ---------- 参与者 (Actors) ----------
actor "普通用户\n(团队·成员)"     as MEMBER
actor "团队管理员"              as TADMIN
actor "团队创建者"              as OWNER
actor "平台管理员"              as PADMIN
' 泛化: 更具体(权限更高) <|-- 更一般 —— 子 actor 继承父 actor 的全部用例
TADMIN <|-- MEMBER
OWNER  <|-- TADMIN
PADMIN <|-- MEMBER
' ---------- 系统边界 ----------
rectangle "log-insight" as SYS {
    ' 认证与用户
    rectangle "认证与用户" {
        usecase "登录"                 as UC_LOGIN
        usecase "登出"                 as UC_LOGOUT
    }
    ' 工作台
    rectangle "工作台" {
        usecase "查看工作台总览"        as UC_DASH
    }
    ' 团队协作
    rectangle "团队协作" {
        usecase "查看团队"             as UC_VTEAM
        usecase "创建团队"             as UC_CTEAM
        usecase "邀请成员"             as UC_INVITE
        usecase "申请加入团队"          as UC_APPLY
        usecase "审批加入申请"          as UC_APPROVE
        usecase "调整成员角色"          as UC_ROLE
        usecase "移除成员"             as UC_REMOVE
        usecase "处理通知"             as UC_NOTICE
    }
    ' 故障诊断 · 日志分析
    rectangle "故障诊断 · 日志分析" {
        usecase "提交日志分析"          as UC_SUBMIT
        usecase "上传预检"             as UC_PRECHECK
        usecase "文件上传日志包"        as UC_UPLOAD
        usecase "粘贴文本分析"          as UC_PASTE
        usecase "查看解析任务"          as UC_LISTTASK
        usecase "查看解析结果"          as UC_RESULT
        usecase "查看原始日志\n(分页筛选)" as UC_RAWLOG
        usecase "发起LLM智能分析"       as UC_LLM
        usecase "取消任务"             as UC_CANCEL
        usecase "删除任务"             as UC_DELTASK
    }
    ' 智能巡检
    rectangle "智能巡检" {
        usecase "发起智能巡检"          as UC_INSPECT
        usecase "规则引擎匹配"          as UC_RULEMATCH
        usecase "LLM智能总结"          as UC_LLM_SUM
        usecase "查看巡检报告"          as UC_INSP_REPORT
    }
    ' 巡检规则管理
    rectangle "巡检规则管理" {
        usecase "查看规则"             as UC_VRULE
        usecase "维护规则\n(增/改/删)"  as UC_MRULE
    }
    ' 性能图表
    rectangle "性能图表" {
        usecase "查询性能数据"          as UC_METRIC
        usecase "保存图表视图配置"      as UC_PREFERENCE
    }
    ' 性能离线分析 (上传即解析)
    rectangle "性能离线分析" {
        usecase "分析 sar 系统性能"     as UC_PERF_SAR
        usecase "分析网络抓包"          as UC_PERF_NET
        usecase "分析 blktrace"        as UC_PERF_BLK
        usecase "分析中断计数变化"      as UC_PERF_IRQ
    }
    ' 审计
    rectangle "审计" {
        usecase "查看审计日志"          as UC_AUDIT
    }
    ' 跨切面能力 (诊断/巡检共用)
    usecase "SSE实时流式输出"          as UC_SSE
}
' ---------- include / extend 关系 ----------
UC_SUBMIT  ..> UC_PRECHECK  : <>
UC_SUBMIT  ..> UC_UPLOAD    : <>
UC_SUBMIT  ..> UC_PASTE     : <>
UC_SUBMIT  ..> UC_RULEMATCH : <>
UC_SUBMIT  ..> UC_SSE       : <>
UC_INSPECT ..> UC_RULEMATCH : <>
UC_INSPECT ..> UC_SSE       : <>
UC_INSPECT ..> UC_LLM_SUM   : <>
UC_RESULT  ..> UC_RAWLOG    : <>
UC_RESULT  ..> UC_LLM       : <>
' ---------- 参与者 <-> 用例 关联 ----------
' 普通用户 (成员): 基础能力
MEMBER --> UC_LOGIN
MEMBER --> UC_LOGOUT
MEMBER --> UC_DASH
MEMBER --> UC_VTEAM
MEMBER --> UC_APPLY
MEMBER --> UC_NOTICE
MEMBER --> UC_SUBMIT
MEMBER --> UC_LISTTASK
MEMBER --> UC_RESULT
MEMBER --> UC_CANCEL
MEMBER --> UC_INSPECT
MEMBER --> UC_INSP_REPORT
MEMBER --> UC_VRULE
MEMBER --> UC_METRIC
MEMBER --> UC_PREFERENCE
MEMBER --> UC_PERF_SAR
MEMBER --> UC_PERF_NET
MEMBER --> UC_PERF_BLK
MEMBER --> UC_PERF_IRQ
' 团队管理员: 在普通用户之上
TADMIN --> UC_CTEAM
TADMIN --> UC_INVITE
TADMIN --> UC_APPROVE
TADMIN --> UC_ROLE
TADMIN --> UC_REMOVE
TADMIN --> UC_DELTASK
TADMIN --> UC_AUDIT
' 平台管理员: 在普通用户之上
PADMIN --> UC_MRULE
' ---------- 说明 ----------
note bottom of PADMIN
  平台管理员: 拥有规则管理权限 (rule:manage)
  且对任意团队自动具备"创建者"级权限
end note
legend right
  |= 关系符号 |= 含义 |
  | 实线 | 参与者 <-> 用例 关联 |
  | 空心三角 (泛化) | 子参与者继承父参与者用例 |
  | ..> <> | 被包含 (必经步骤) |
  | ..> <> | 可选扩展 (视条件/配置) |
endlegend
@enduml