# 环境配置示例 (复制为 .env 后修改)
# ---- 基础 ----
DEBUG=false
SECRET_KEY=CHANGE-ME-USE-RANDOM-STRING

# ---- 数据库 (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://loginsight:loginsight@localhost:5432/loginsight

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- 存储 ----
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=2048

# ---- Worker ----
WORKER_CONCURRENCY=8
WORKER_CONSUMER_NAME=

# ---- LLM (OpenAI 兼容 API, 留空则降级为纯规则分析) ----
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_CONCURRENCY=4

# ---- 智能诊断智能体 (DeepSeek Harness / ACP) ----
# 平台默认 DeepSeek 密钥 (可选); 用户可在诊断页配置自己的 Key 与供应商
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
AGENT_MODEL=deepseek-flash
AGENT_HARNESS_DIR=../harness
AGENT_PROTOCOL=messages
AGENT_PERMISSION_MODE=workspace-write

# ---- 指标 ----
METRIC_RETENTION_DAYS=90

# ---- 知识库 ----
KB_ENABLED=true
KB_DEFAULT_TOP_K=10
KB_DEFAULT_QUERY_COUNT=8
KB_SEARCH_RECALL_PER_QUERY=30
KB_CONTEXT_MAX_CHARS=24000
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=64
KB_MAX_UPLOAD_MB=20
